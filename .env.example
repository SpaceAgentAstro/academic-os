# Copy this file to .env and fill in your values.
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are required for delivery.

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
BRIEFING_TIME=07:30
TESSERACT_CMD=tesseract
PIX2TEX_ENABLED=true
LOG_LEVEL=INFO

# --- API access control -----------------------------------------------------
# When set, every endpoint except /api/health requires this key via an
# X-API-Key header (or Authorization: Bearer). Leave blank only for trusted
# local development. The frontend sends it via NEXT_PUBLIC_API_KEY (below).
API_KEY=

# Comma-separated browser origins allowed by CORS. Include the deployed frontend
# origin in production, e.g. https://academic-os.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Per-client request budget per minute (in-process rate limiter).
RATE_LIMIT_PER_MINUTE=120

# --- Backend bind (start-backend.sh) ----------------------------------------
# Bind to localhost by default; only expose on 0.0.0.0 behind an authenticating
# TLS-terminating reverse proxy.
HOST=127.0.0.1
PORT=8000

# --- Frontend (Next.js, must be prefixed NEXT_PUBLIC_) -----------------------
# Set to the deployed backend origin (HTTPS in production); defaults to the
# local dev backend when unset.
# NEXT_PUBLIC_API_URL=https://api.your-domain.example
# NEXT_PUBLIC_API_KEY=
