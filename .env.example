# Copy this file to .env and fill in your values
# TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are required for delivery

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
BRIEFING_TIME=07:30
TESSERACT_CMD=tesseract
PIX2TEX_ENABLED=true
LOG_LEVEL=INFO

# --- Backend API security / deployment (LOGIC-002, AOS-001/003/014) ---------
# Shared secret. When set, every non-health API route requires a matching
# `X-API-Key` (or `Authorization: Bearer <key>`) header. Leave empty for local
# dev; set it (and bind behind an authenticating proxy) for any public deploy.
API_KEY=
# Comma-separated CORS origins for the deployed frontend (no trailing slash).
# e.g. https://academic-os.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Per-client request budget (sliding 60s window); 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=120
# Uvicorn bind host/port for start-backend.sh (default 127.0.0.1:8000).
HOST=127.0.0.1
PORT=8000

# --- Frontend (Next.js) build-time vars -------------------------------------
# Base URL the browser uses to reach the backend API. MUST be set in production
# (e.g. on Vercel) or the deployed app falls back to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: API key the frontend sends as X-API-Key when the backend requires one.
NEXT_PUBLIC_API_KEY=
