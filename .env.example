# Copy this file to .env and fill in your values.

# --- Telegram delivery (required for briefings) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
BRIEFING_TIME=07:30

# --- OCR ---
TESSERACT_CMD=tesseract
PIX2TEX_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO

# --- Backend API security / deployment ---
# Comma-separated allowed CORS origins (the deployed frontend origin in prod).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Server-side API key. When set, every /api route except /api/health requires
# an `X-API-Key` header. REQUIRED before exposing the API beyond localhost.
API_KEY=
# Bind host for start-backend.sh (keep 127.0.0.1 unless behind an auth proxy).
HOST=127.0.0.1
PORT=8000
# Rate limit: requests per window (seconds) per client IP.
RATE_LIMIT=120
RATE_LIMIT_WINDOW=60

# --- Frontend (Next.js, must be prefixed NEXT_PUBLIC_) ---
# URL of the deployed backend; localhost is only for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Must match the backend API_KEY above when one is configured.
NEXT_PUBLIC_API_KEY=
