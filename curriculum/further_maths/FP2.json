{
  "subject": "Further Mathematics",
  "module_code": "FP2",
  "module_name": "Further Pure Mathematics 2",
  "topics": [
    {
      "name": "Further Complex Numbers",
      "subtopics": [
        {
          "name": "Euler's Form and Exponential Form",
          "specification_points": [
            {
              "spec_ref": "1.1.1",
              "description": "Know and use Euler's formula e^(i\u03b8) = cos\u03b8 + i sin\u03b8"
            },
            {
              "spec_ref": "1.1.2",
              "description": "Express complex numbers in exponential form re^(i\u03b8)"
            },
            {
              "spec_ref": "1.1.3",
              "description": "Solve problems using exponential form"
            }
          ]
        }
      ]
    },
    {
      "name": "Further Matrices",
      "subtopics": [
        {
          "name": "3\u00d73 Matrices",
          "specification_points": [
            {
              "spec_ref": "2.1.1",
              "description": "Calculate the determinant and inverse of a 3\u00d73 matrix"
            },
            {
              "spec_ref": "2.1.2",
              "description": "Use matrices to represent 3D transformations"
            },
            {
              "spec_ref": "2.1.3",
              "description": "Solve systems of 3 linear equations using matrix methods or row reduction"
            }
          ]
        }
      ]
    },
    {
      "name": "Inequalities",
      "subtopics": [
        {
          "name": "Algebraic Inequalities",
          "specification_points": [
            {
              "spec_ref": "3.1.1",
              "description": "Solve inequalities involving rational functions: f(x)/g(x) > k"
            },
            {
              "spec_ref": "3.1.2",
              "description": "Solve inequalities involving modulus"
            },
            {
              "spec_ref": "3.1.3",
              "description": "Solve inequalities graphically and algebraically"
            }
          ]
        }
      ]
    },
    {
      "name": "Further Coordinate Geometry",
      "subtopics": [
        {
          "name": "Conic Sections",
          "specification_points": [
            {
              "spec_ref": "4.1.1",
              "description": "Know and use the equations of parabola (y\u00b2 = 4ax), ellipse (x\u00b2/a\u00b2 + y\u00b2/b\u00b2 = 1), hyperbola (x\u00b2/a\u00b2 - y\u00b2/b\u00b2 = 1)"
            },
            {
              "spec_ref": "4.1.2",
              "description": "Find tangents and normals to conic sections"
            },
            {
              "spec_ref": "4.1.3",
              "description": "Understand the focus-directrix property and eccentricity"
            },
            {
              "spec_ref": "4.1.4",
              "description": "Use parametric forms for conics"
            }
          ]
        }
      ]
    },
    {
      "name": "Calculus of Hyperbolic Functions",
      "subtopics": [
        {
          "name": "Hyperbolic Functions",
          "specification_points": [
            {
              "spec_ref": "5.1.1",
              "description": "Know definitions: sinh x = (e\u02e3 - e\u207b\u02e3)/2, cosh x = (e\u02e3 + e\u207b\u02e3)/2, tanh x"
            },
            {
              "spec_ref": "5.1.2",
              "description": "Prove and use identities: cosh\u00b2x - sinh\u00b2x = 1"
            },
            {
              "spec_ref": "5.1.3",
              "description": "Differentiate and integrate hyperbolic functions"
            },
            {
              "spec_ref": "5.1.4",
              "description": "Know and use inverse hyperbolic functions arsinh, arcosh, artanh"
            }
          ]
        }
      ]
    },
    {
      "name": "Further Integration Techniques",
      "subtopics": [
        {
          "name": "Reduction Formulae",
          "specification_points": [
            {
              "spec_ref": "6.1.1",
              "description": "Derive and use reduction formulae for I\u2099 = \u222bx\u207fe\u02e3 dx, \u222bsin\u207fx dx etc."
            },
            {
              "spec_ref": "6.1.2",
              "description": "Apply reduction formulae to evaluate definite integrals"
            }
          ]
        },
        {
          "name": "Arc Length and Surface Area",
          "specification_points": [
            {
              "spec_ref": "6.2.1",
              "description": "Calculate arc length: L = \u222b\u221a(1 + (dy/dx)\u00b2) dx"
            },
            {
              "spec_ref": "6.2.2",
              "description": "Calculate surface area of revolution: S = 2\u03c0\u222by \u221a(1 + (dy/dx)\u00b2) dx"
            }
          ]
        }
      ]
    }
  ]
}
