            {
              "spec_ref": "3.1.2",
              "description": "Describe the behaviour of materials under stress: elastic, plastic, fracture"
            },
            {
              "spec_ref": "3.1.3",
              "description": "Interpret and sketch stress-strain graphs for metals, polymers, and ceramics"
            },
            {
              "spec_ref": "3.1.4",
              "description": "Calculate energy stored in a stretched material: E = \u00bdFe = \u00bdkx\u00b2"
