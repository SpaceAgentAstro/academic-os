          "name": "Probability Distributions",
          "specification_points": [
            {
              "spec_ref": "4.1.1",
              "description": "Set up and use probability distribution tables"
            },
            {
              "spec_ref": "4.1.2",
              "description": "Calculate E(X), Var(X), E(aX+b), Var(aX+b)"
            }
          ]
        },
        {
          "name": "Binomial Distribution",
          "specification_points": [
            {
              "spec_ref": "4.2.1",
              "description": "Recognise and use the binomial distribution B(n, p)"
